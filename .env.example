# Site URL (canonical / OG). Optional on Vercel if you use the production default.
# NEXT_PUBLIC_SITE_URL=https://www.reactfield.dev

# Giscus comments (https://giscus.app) — copy category + category-id from the generated embed code.
NEXT_PUBLIC_GISCUS_REPO=MhamedEl-shahawy/ReactField
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# Home page only: link to a specific discussion by number (title shows as "… #8" in GitHub).
NEXT_PUBLIC_GISCUS_HOME_DISCUSSION_NUMBER=8
